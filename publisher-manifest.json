 }\n        .card:hover {\n            transform: translateY(-6px);\n        }\n        .card.featured {\n            border-color: var(--forest);\n            box-shadow: 0 8px 25px rgba(46,125,50,0.12);\n        }\n        .plan-price {\n            font-size: 2.1rem;\n            font-weight: 700;\n            color: var(--forest);\n            margin: 12px 0;\n        }\n        .faq {\n            margin: 30px 0;\n        }\n        details {\n            background: #f8f4ed;\n            margin: 14px 0;\n            border-radius: 10px;\n            padding: 4px;\n        }\n        summary {\n            font-weight: 600;\n            padding: 18px 22px;\n            cursor: pointer;\n            font-size: 1.1rem;\n            color: var(--forest);\n            list-style: none;\n        }\n        summary::-webkit-details-marker {\n            display: none;\n        }\n        .faq-content {\n            padding: 0 22px 22px;\n            color: #444;\n        }\n        footer {\n            text-align: center;\n            padding: 50px 20px 30px;\n            font-size: 0.95rem;\n            color: #666;\n        }\n        a {\n            color: var(--forest);\n            text-decoration: none;\n        }\n        a:hover {\n            text-decoration: underline;\n        }\n        @media (max-width: 768px) {\n            h1 { font-size: 2.6rem; }\n            .features { grid-template-columns: 1fr; }\n        }\n    </style>\n\n\n    <header>\n        <h1>clashmeta</h1>\n        <p class=\"subtitle\">专业VPN加速器 | 客户端下载 | 机场订阅 | 高速网络加速</p>\n    </header>\n\n    <main>\n        <section>\n            <h2>品牌简介</h2>\n            <p>clashmeta 是一款专注于提供优质VPN网络加速服务的品牌，致力于帮助用户获得稳定、高速、安全的互联网连接。无论是在日常浏览、流媒体解锁还是在线游戏，我们都提供专业客户端与订阅方案，让您畅享无障碍网络体验。</p>\n        </section>\n\n        <section>\n            <h2>使用场景</h2>\n            <div class=\"features\">\n                <div class=\"card\">\n                    <h3>流媒体解锁</h3>\n                    <p>解锁Netflix、YouTube、Disney+ 等全球主流平台内容，支持基础与全节点原生解锁方案。</p>\n                </div>\n                <div class=\"card\">\n                    <h3>游戏加速</h3>\n                    <p>IPLC专线优化，降低延迟，提升在线游戏稳定性，适合电竞玩家与多人网络游戏。</p>\n                </div>\n                <div class=\"card\">\n                    <h3>隐私保护</h3>\n                    <p>加密传输保护您的上网数据，适合对隐私有要求的商务与个人用户。</p>\n                </div>\n            </div>\n        </section>\n\n        <section>\n            <h2>操作说明</h2>\n            <p>1. 访问官网选择适合您的套餐并完成支付。</p>\n            <p>2. 登录账号后获取订阅链接。</p>\n            <p>3. 下载推荐客户端（Clash Meta、Clash Verge 等）。</p>\n            <p>4. 导入订阅链接并连接节点，即可使用。</p>\n            <p>5. 设备支持多端同时在线，操作简单便捷。</p>\n        </section>\n\n        <section>\n            <h2>套餐选择</h2>\n            <div class=\"features\">\n                <div class=\"card\">\n                    <h3>基础版</h3>\n                    <div class=\"plan-price\">¥15/月</div>\n                    <div>按年付仅需 ¥150/年</div>\n                    <ul>\n                        <li>每月 100GB 极速流量</li>\n                        <li>支持 3 台设备同时在线</li>\n                        <li>解锁基础流媒体</li>\n                        <li>普通线路节点池</li>\n                    </ul>\n                </div>\n\n                <div class=\"card featured\">\n                    <h3>旗舰版<span>推荐</span></h3>\n                    <div class=\"plan-price\">¥35/月</div>\n                    <div>按年付仅需 ¥350/年</div>\n                    <ul>\n                        <li>每月 300GB 极速流量</li>\n                        <li>支持 5 台设备同时在线</li>\n                        <li>全节点原生流媒体解锁</li>\n                        <li>IPLC 专线游戏加速优化</li>\n                        <li>7x24 优先工单支持</li>\n                    </ul>\n                </div>\n\n                <div class=\"card\">\n                    <h3>团队版</h3>\n                    <div class=\"plan-price\">¥85/月</div>\n                    <div>按年付仅需 ¥850/年</div>\n                    <ul>\n                        <li>每月 1000GB 极速流量</li>\n                        <li>支持 20 台设备同时在线</li>\n                        <li>VIP 专属高带宽节点</li>\n                        <li>支持企业定制路由</li>\n                        <li>专属客户经理服务</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"faq\">\n            <h2>常见问题</h2>\n            <details>\n                <summary>如何选择套餐？</summary>\n                <div class=\"faq-content\">\n                    <p>基础版适合个人轻度使用；旗舰版为大多数用户推荐，流量与速度兼顾；团队版适合多人共享或企业使用。</p>\n                </div>\n            </details>\n            <details>\n                <summary>支持哪些客户端？</summary>\n                <div class=\"faq-content\">\n                    <p>官方推荐使用 Clash Meta 客户端，也支持 Clash Verge、NekoBox 等第三方工具，订阅链接通用。</p>\n                </div>\n            </details>\n            <details>\n                <summary>节点质量如何？</summary>\n                <div class=\"faq-content\">\n                    <p>所有线路均经过优化，采用 IPLC 专线，延迟低、速度快，日常使用稳定可靠。</p>\n                </div>\n            </details>\n            <details>\n                <summary>支持多少台设备同时在线？</summary>\n                <div class=\"faq-content\">\n                    <p>基础版 3 台，旗舰版 5 台，团队版 20 台，根据套餐等级而定。</p>\n                </div>\n            </details>\n            <details>\n                <summary>售后服务如何？</summary>\n                <div class=\"faq-content\">\n                    <p>旗舰版及以上提供 7x24 优先工单支持，团队版有专属客户经理全程服务。</p>\n                </div>\n            </details>\n            <details>\n                <summary>如何获取订阅链接？</summary>\n                <div class=\"faq-content\">\n                    <p>登录账号后在仪表盘直接获取，订阅链接有效期内保持有效。</p>\n                </div>\n            </details>\n        </section>\n    <section><h2>套餐</h2>{{PLANS_HTML}}</section><section><h2>客户端</h2>{{CLIENTS_HTML}}</section></main>\n\n    <footer>\n        <p>© 2024 clashmeta 官网 | 所有套餐支持官方客户端下载与机场订阅</p>\n        <p>如有问题请联系客服获取帮助</p>\n    </footer>\n\n",
